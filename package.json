{
  "name": "aventuras-magicas",
  "version": "1.0.0",
  "description": "Elige tu propia aventura para aprender inglés (6-8 años). Red de nodos con caminos finitos.",
  "private": true,
  "scripts": {
    "validate": "node tools/validate.js",
    "serve": "python3 -m http.server 8080 --directory www",
    "android:add": "npx cap add android",
    "android:sync": "npm run validate && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/app": "^6.0.1",
    "@capacitor/core": "^6.1.2",
    "@capacitor-community/text-to-speech": "^4.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}
